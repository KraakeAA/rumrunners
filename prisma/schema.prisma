
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  player       Player?
}

model Player {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  rank         String   @default("Scum")
  rankLevel    Int      @default(1)
  money        Int      @default(500)
  bank         Int      @default(0)
  bullets      Int      @default(0)
  health       Int      @default(100)
  protection   Int      @default(0)
  energy       Int      @default(10)
  maxEnergy    Int      @default(10)
  experience   Int      @default(0)
  lastEnergyAt DateTime @default(now())
  lastCrimeAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]
  crimeLogs  CrimeLog[]
  casinoLogs CasinoLog[]
}

model InventoryItem {
  id       String @id @default(cuid())
  playerId String
  itemType String
  quantity Int    @default(1)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemType])
}

model CrimeLog {
  id         String   @id @default(cuid())
  playerId   String
  crimeType  String
  success    Boolean
  cashChange Int
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CasinoLog {
  id        String   @id @default(cuid())
  playerId  String
  game      String
  bet       Int
  payout    Int
  outcome   Json
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}
