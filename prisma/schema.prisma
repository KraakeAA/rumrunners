generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  isAdmin      Boolean  @default(false)
  // A banned account is signed out everywhere and cannot sign back in.
  banned       Boolean  @default(false)
  // Staff below admin: "HELPER" answers tickets; "MODERATOR" also bans and handles reports.
  staffRole    String?
  banReason    String?
  bannedAt     DateTime?

  player Player?
}

// A development update shown on the Updates page. Only admins can write them.
model Update {
  id         String   @id @default(cuid())
  title      String
  body       String   @db.Text
  authorName String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Player {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  rank         String   @default("Scum")
  rankLevel    Int      @default(1)
  money        Int      @default(500)
  bank         Int      @default(0)
  // When the bank balance last changed; interest is paid 24 hours after this.
  bankSince    DateTime?
  gold         Int      @default(0)
  bullets      Int      @default(0)
  health       Int      @default(100)
  protection   Int      @default(0)
  // What the player is wearing or carrying: slot name -> store item key (e.g. {"hat":"protection:steel_hat"}).
  equipped     Json?
  // New-player protection from attack, set at sign-up and again after each rebirth.
  shieldUntil  DateTime?
  // Set when health reaches 0. Cleared by rebirth.
  diedAt       DateTime?
  killedBy     String?
  // Health heals slowly; healthAt is when the last point was gained. kills is a lifetime count.
  healthAt     DateTime?
  kills        Int      @default(0)
  // When this life began. Bank history before this belongs to a previous life.
  bornAt       DateTime @default(now())
  // Gymnasium training points (level = square root). See src/lib/training.ts.
  strengthPts  Int      @default(0)
  staminaPts   Int      @default(0)
  agilityPts   Int      @default(0)
  energy       Int      @default(400)
  maxEnergy    Int      @default(400)
  experience   Int      @default(0)
  lastEnergyAt DateTime @default(now())
  lastCrimeAt  DateTime?
  lastTheftAt  DateTime?
  // When each auto theft level was last tried, keyed by level number.
  theftTimes   Json?
  // Jail: free when jailUntil is empty or in the past.
  jailUntil    DateTime?
  jailReason   String?
  jailSecurity Int      @default(1)
  selfBustUsed Boolean  @default(false)
  // Busting other players out: totals and streaks (a streak of fails is negative).
  bustWins     Int      @default(0)
  bustFails    Int      @default(0)
  bustStreak   Int      @default(0)
  bustBest     Int      @default(0)
  bustWorst    Int      @default(0)
  // How many cars the garage holds (the Store sells more), and the booze being carried.
  garageSlots  Int      @default(5)
  cargo        Json?
  // Where each crate being carried was bought: booze key -> city -> crates. Crates can't be sold where they were bought.
  cargoFrom    Json?
  // Lifetime counters shown on the statistics page.
  theftWins     Int @default(0)
  theftFails    Int @default(0)
  boozeBought   Int @default(0) // crates
  boozeSold     Int @default(0) // crates
  boozeSpent    Int @default(0)
  boozeEarned   Int @default(0)
  ocsDone       Int @default(0)
  ocsLed        Int @default(0)
  ocEarned      Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Location and railway travel
  currentCity      String    @default("London")
  travelDestination String?
  travelStartedAt   DateTime?
  travelArrivesAt   DateTime?

  // Profile information
  profilePictureUrl String? @db.Text
  profileQuote      String? @db.Text
  profileStatus     String? @db.Text
  statusExpiresAt   DateTime?
  profileViews      Int     @default(0)

  // Profile privacy and display preferences
  profileVisible     Boolean @default(true)
  showProfileViews   Boolean @default(true)
  showHistory        Boolean @default(false)
  showBirthday       Boolean @default(false)
  showCountry        Boolean @default(false)
  showOrganization   Boolean @default(true)
  showOcStatus       Boolean @default(true)
  allowProfileImages Boolean @default(true)
  friendsOnlyImages  Boolean @default(false)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]
  crimeLogs  CrimeLog[]
  casinoLogs CasinoLog[]

  forumTopics ForumTopic[] @relation("ForumTopicAuthor")
  forumPosts  ForumPost[]  @relation("ForumPostAuthor")
  bustMilestones BustMilestone[]

  ownedCasinos         Casino[]        @relation("CasinoOwner")
  ownedBulletFactories BulletFactory[] @relation("BulletFactoryOwner")
  cars                 Car[]

  // Organised crime: at most one crew led, any number of invitations.
  ocLed    OrganisedCrime?
  ocSlots  OcSlot[]  @relation("OcMember")
  inbox    Message[] @relation("MailTo")

  bjHand        BlackjackHand?
  lotteryTickets LotteryTicket[]
  goldListings   GoldListing[]

  // Crews (gangs): at most one crew joined or led, and any number of applications.
  crewId           String?
  crew             Crew?             @relation("CrewMembers", fields: [crewId], references: [id], onDelete: SetNull)
  ledCrew          Crew?             @relation("CrewLeader")
  crewApplications CrewApplication[]
  crewDonations    CrewDonation[]
  tickets          Ticket[]

  @@index([crewId])
}

// A crew (gang). Only ten can exist at once. Members pay into the crew bank; only the leader can take money out.
model Crew {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  motto     String?  @db.Text
  // The questions an applicant must answer, set by the leader: a list of strings.
  questions Json?
  bank      Int      @default(0)
  leaderId  String   @unique
  createdAt DateTime @default(now())

  leader       Player            @relation("CrewLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members      Player[]          @relation("CrewMembers")
  applications CrewApplication[]
  donations    CrewDonation[]
}

// A player's application to join a crew, with their answers. Deleted once the leader decides.
model CrewApplication {
  id        String   @id @default(cuid())
  crewId    String
  playerId  String
  answers   Json?
  createdAt DateTime @default(now())

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([crewId, playerId])
}

// Money a member put into the crew bank.
model CrewDonation {
  id        String   @id @default(cuid())
  crewId    String
  playerId  String
  amount    Int
  createdAt DateTime @default(now())

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([crewId])
}

// A car in a player's garage. The model key points into src/lib/era.ts.
model Car {
  id        String   @id @default(cuid())
  ownerId   String
  model     String
  originCity String  @default("London") // where it was stolen
  city       String  @default("London") // where it is now
  heat       Int     @default(0)
  plate      String  @default("")
  damage     Int     @default(0) // 0 = perfect, 50 = badly knocked about
  heatAt     DateTime @default(now())
  // Crates of booze in the boot, keyed by booze key.
  cargo      Json?
  // Set while the car is held by the Escrow agent; it can't be used or sold until the trade ends.
  escrowId   String?
  createdAt DateTime @default(now())

  owner Player @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// One casino per game per city. ownerId = null means the house runs it.
model Casino {
  id         String    @id @default(cuid())
  city       String
  game       String
  ownerId    String?
  maxBet     Int       @default(5000)
  profit     Int       @default(0)
  plays      Int       @default(0)
  wagered    Int       @default(0)
  ownedSince DateTime?
  // The casino bankroll, held as chips. Players bet against these, not the owner's cash.
  chips      Int       @default(0)
  // A new owner gets a few minutes to stock the casino before anyone may play.
  openAt     DateTime?
  // Set while the casino is held by the Escrow agent: nobody can gamble at it or change it.
  escrowId   String?

  owner Player? @relation("CasinoOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([city, game])
  @@index([ownerId])
}

// One bullet factory per city. Produces a batch on a timer while the owner
// can pay for the steel.
model BulletFactory {
  id             String   @id @default(cuid())
  city           String   @unique
  ownerId        String?
  stock          Int      @default(0)
  pricePerBullet Int      @default(3)
  lastProducedAt DateTime @default(now())
  totalProduced  Int      @default(0)
  revenue        Int      @default(0)

  owner Player? @relation("BulletFactoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model InventoryItem {
  id       String @id @default(cuid())
  playerId String
  itemType String
  quantity Int    @default(1)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemType])
}

model CrimeLog {
  id         String   @id @default(cuid())
  playerId   String
  crimeType  String
  success    Boolean
  cashChange Int
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CasinoLog {
  id        String   @id @default(cuid())
  playerId  String
  game      String
  bet       Int
  payout    Int
  outcome   Json
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model ForumTopic {
  id        String   @id @default(cuid())
  category  String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String

  author Player       @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  posts  ForumPost[]

  @@index([category, pinned, createdAt])
}

model ForumPost {
  id        String   @id @default(cuid())
  body      String   @db.Text
  createdAt DateTime @default(now())
  authorId  String
  topicId   String

  author Player     @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
}
// A four-player organised crime: one leader and three role slots.
model OrganisedCrime {
  id        String   @id @default(cuid())
  leaderId  String   @unique
  city      String
  status    String   @default("forming")
  createdAt DateTime @default(now())

  leader Player   @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  slots  OcSlot[]
}

// One of the three positions. state: empty, invited, selecting or ready.
// While invited, playerId is the person who has been asked.
model OcSlot {
  id       String  @id @default(cuid())
  ocId     String
  role     String
  state    String  @default("empty")
  playerId String?
  percent  Int?
  choice   String?
  carId    String?

  oc     OrganisedCrime @relation(fields: [ocId], references: [id], onDelete: Cascade)
  player Player?        @relation("OcMember", fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([ocId, role])
  @@index([playerId])
}

// A letter in a player's mailbox.
model Message {
  id        String    @id @default(cuid())
  toId      String
  fromName  String
  subject   String
  body      String    @db.Text
  ocId      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  to Player @relation("MailTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, createdAt])
}

// A blackjack hand in progress. The bet is held here until the hand ends.
model BlackjackHand {
  id        String   @id @default(cuid())
  playerId  String   @unique
  city      String
  bet       Int
  deck      Json
  player    Json
  dealer    Json
  createdAt DateTime @default(now())

  owner Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// One ticket in the weekly lottery. drawAt is the Wednesday draw it is entered in.
model LotteryTicket {
  id        String   @id @default(cuid())
  playerId  String
  drawAt    DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([drawAt])
  @@index([playerId, drawAt])
}

// The result of a weekly lottery draw. One row per draw, so it only runs once.
model LotteryDraw {
  id         String   @id @default(cuid())
  drawAt     DateTime @unique
  tickets    Int
  pot        Int
  prize      Int
  winnerName String?
  drawnAt    DateTime @default(now())
}

// A name that has died. Names are kept so they stay reserved and can be revived.
model PastLife {
  id        String    @id @default(cuid())
  userId    String
  username  String    @unique
  rank      String
  rankLevel Int       @default(1)
  diedAt    DateTime  @default(now())
  killedBy  String?
  revivedAt DateTime?

  @@index([userId])
}

// A detective hired to find another player. When found there is a window to shoot them.
// status: searching, found, done, lost, expired.
model Hunt {
  id          String    @id @default(cuid())
  hunterId    String
  targetId    String
  targetName  String
  tier        String
  cost        Int
  createdAt   DateTime  @default(now())
  foundAt     DateTime
  status      String    @default("searching")
  foundCity   String?
  windowEndsAt DateTime?
  shots       Int       @default(0)

  @@index([hunterId, createdAt])
  @@index([targetId])
}

// A price on a player's head. status: active, paid (claimed by whoever killed him), bought_off.
model Bounty {
  id         String    @id @default(cuid())
  targetId   String
  targetName String
  placerId   String
  placerName String
  amount     Int
  reason     String    @default("")
  anonymous  Boolean   @default(false)
  status     String    @default("active")
  claimedBy  String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, amount])
  @@index([targetId, status])
}

// Money sent from one player's bank account to another's. The fee is destroyed.
// kind: "player" for a direct transfer (later "marketplace" for Marketplace and Escrow sales).
model Transfer {
  id         String   @id @default(cuid())
  fromId     String
  fromName   String
  toId       String
  toName     String
  amount     Int
  fee        Int
  received   Int
  reference  String   @default("")
  kind       String   @default("player")
  createdAt  DateTime @default(now())

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

// Gold put up for sale on the Marketplace. The gold is taken from the seller when listed and held here.
// remaining = gold still unsold. Buyers take whole batches (batchSize 1 = sold individually,
// batchSize = the full amount = sold all together). status: active, sold, removed.
model GoldListing {
  id         String   @id @default(cuid())
  sellerId   String
  sellerName String
  amount     Int
  remaining  Int
  batchSize  Int      @default(1)
  price      Int
  status     String   @default("active")
  createdAt  DateTime @default(now())

  seller Player @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, price])
  @@index([sellerId, status])
}

// One purchase of gold from a listing. The latest price is the "recent value".
model GoldSale {
  id        String   @id @default(cuid())
  listingId String
  sellerId  String
  buyerId   String
  quantity  Int
  price     Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A trade between two players, held by the Escrow agent. status: invited, active, completed, cancelled.
// a is the player who sent the invitation, b the one invited. Items are held until both sides agree.
model Escrow {
  id          String    @id @default(cuid())
  aId         String
  aName       String
  bId         String
  bName       String
  status      String    @default("invited")
  aLocked     Boolean   @default(false)
  bLocked     Boolean   @default(false)
  aAgreed     Boolean   @default(false)
  bAgreed     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  // The trade is cancelled automatically if it isn't finished by then (30 minutes).
  expiresAt   DateTime?

  items EscrowItem[]

  @@index([aId, status])
  @@index([bId, status])
}

// One thing a player has put into an escrow: cash, gold or a car.
model EscrowItem {
  id        String   @id @default(cuid())
  escrowId  String
  ownerId   String
  kind      String
  amount    Int      @default(0)
  carId     String?
  casinoId  String?
  statementId String?
  // What to call the item on screen: the car and its plate, or the casino and its city.
  carName   String   @default("")
  createdAt DateTime @default(now())

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

// A help ticket. status: open (waiting for staff), answered (staff replied), closed.
model Ticket {
  id        String   @id @default(cuid())
  playerId  String
  category  String
  subject   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([status, updatedAt])
  @@index([playerId])
}

// One message in a ticket, from the player or from staff.
model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorName String
  isStaff    Boolean  @default(false)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}


// Totals from lives that have ended (rebirth zeroes a player's own counters), so the
// game-wide statistics keep counting them. One row, id "retired".
model StatRetired {
  id          String @id
  theftWins   Int    @default(0)
  theftFails  Int    @default(0)
  ocsLed      Int    @default(0)
  ocEarned    Int    @default(0)
  kills       Int    @default(0)
  boozeSold   Int    @default(0)
  crimesTotal Int    @default(0)
  crimesWon   Int    @default(0)
  crimeCash   Int    @default(0)
}

// The game-wide statistics page, worked out once an hour and kept so it survives restarts.
model StatSnapshot {
  id      String   @id @default(cuid())
  takenAt DateTime @default(now())
  data    Json

  @@index([takenAt])
}

// A landmark bust (1st, 10th, 100th...) and who was freed.
model BustMilestone {
  id        String   @id @default(cuid())
  playerId  String
  number    Int
  freed     String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, number])
}

// A witness statement: "you saw killerName shoot victimName in city". A tradeable item.
// escrowId is set while the Escrow agent is holding it.
model Statement {
  id         String   @id @default(cuid())
  ownerId    String
  killerName String
  victimName String
  city       String
  escrowId   String?
  // Closed until the holder opens it. Opening shows who did it, and can't be undone.
  opened     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

