generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  isAdmin      Boolean  @default(false)
  // A banned account is signed out everywhere and cannot sign back in.
  banned       Boolean  @default(false)
  // Staff below admin: "HELPER" answers tickets; "MODERATOR" also bans and handles reports.
  staffRole    String?
  banReason    String?
  bannedAt     DateTime?

  player Player?
}

// A development update shown on the Updates page. Only admins can write them.
model Update {
  id         String   @id @default(cuid())
  title      String
  body       String   @db.Text
  authorName String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Player {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  rank         String   @default("Scum")
  rankLevel    Int      @default(1)
  money        Int      @default(500)
  bank         Int      @default(0)
  // When the bank balance last changed; interest is paid 24 hours after this.
  bankSince    DateTime?
  gold         Int      @default(0)
  bullets      Int      @default(0)
  health       Int      @default(100)
  protection   Int      @default(0)
  // What the player is wearing or carrying: slot name -> store item key (e.g. {"hat":"protection:steel_hat"}).
  equipped     Json?
  // New-player protection from attack, set at sign-up and again after each rebirth.
  shieldUntil  DateTime?
  // Set when health reaches 0. Cleared by rebirth.
  diedAt       DateTime?
  killedBy     String?
  // Health heals slowly; healthAt is when the last point was gained. kills is a lifetime count.
  healthAt     DateTime?
  kills        Int      @default(0)
  // When this life began. Bank history before this belongs to a previous life.
  bornAt       DateTime @default(now())
  // Gymnasium training points (level = square root). See src/lib/training.ts.
  strengthPts  Int      @default(0)
  staminaPts   Int      @default(0)
  agilityPts   Int      @default(0)
  energy       Int      @default(400)
  maxEnergy    Int      @default(400)
  experience   Int      @default(0)
  lastEnergyAt DateTime @default(now())
  lastCrimeAt  DateTime?
  lastTheftAt  DateTime?
  // When each auto theft level was last tried, keyed by level number.
  theftTimes   Json?
  // Jail: free when jailUntil is empty or in the past.
  jailUntil    DateTime?
  jailReason   String?
  jailSecurity Int      @default(1)
  selfBustUsed Boolean  @default(false)
  // How many cars the garage holds (the Store sells more), and the booze being carried.
  garageSlots  Int      @default(5)
  cargo        Json?
  // Where each crate being carried was bought: booze key -> city -> crates. Crates can't be sold where they were bought.
  cargoFrom    Json?
  // Lifetime counters shown on the statistics page.
  theftWins     Int @default(0)
  theftFails    Int @default(0)
  boozeBought   Int @default(0) // crates
  boozeSold     Int @default(0) // crates
  boozeSpent    Int @default(0)
  boozeEarned   Int @default(0)
  ocsDone       Int @default(0)
  ocsLed        Int @default(0)
  ocEarned      Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Location and railway travel
  currentCity      String    @default("London")
  travelDestination String?
  travelStartedAt   DateTime?
  travelArrivesAt   DateTime?

  // Profile information
  profilePictureUrl String? @db.Text
  profileQuote      String? @db.Text
  profileStatus     String? @db.Text
  statusExpiresAt   DateTime?
  profileViews      Int     @default(0)

  // Profile privacy and display preferences
  profileVisible     Boolean @default(true)
  showProfileViews   Boolean @default(true)
  showHistory        Boolean @default(false)
  showBirthday       Boolean @default(false)
  showCountry        Boolean @default(false)
  showOrganization   Boolean @default(true)
  showOcStatus       Boolean @default(true)
  allowProfileImages Boolean @default(true)
  friendsOnlyImages  Boolean @default(false)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]
  crimeLogs  CrimeLog[]
  casinoLogs CasinoLog[]

  forumTopics ForumTopic[] @relation("ForumTopicAuthor")
  forumPosts  ForumPost[]  @relation("ForumPostAuthor")

  ownedCasinos         Casino[]        @relation("CasinoOwner")
  ownedBulletFactories BulletFactory[] @relation("BulletFactoryOwner")
  cars                 Car[]

  // Organised crime: at most one crew led, any number of invitations.
  ocLed    OrganisedCrime?
  ocSlots  OcSlot[]  @relation("OcMember")
  inbox    Message[] @relation("MailTo")

  bjHand        BlackjackHand?
  lotteryTickets LotteryTicket[]
  goldListings   GoldListing[]

  // Crews (gangs): at most one crew joined or led, and any number of applications.
  crewId           String?
  crew             Crew?             @relation("CrewMembers", fields: [crewId], references: [id], onDelete: SetNull)
  ledCrew          Crew?             @relation("CrewLeader")
  crewApplications CrewApplication[]
  crewDonations    CrewDonation[]
  tickets          Ticket[]

  @@index([crewId])
}

// A crew (gang). Only ten can exist at once. Members pay into the crew bank; only the leader can take money out.
model Crew {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  motto     String?  @db.Text
  // The questions an applicant must answer, set by the leader: a list of strings.
  questions Json?
  bank      Int      @default(0)
  leaderId  String   @unique
  createdAt DateTime @default(now())

  leader       Player            @relation("CrewLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members      Player[]          @relation("CrewMembers")
  applications CrewApplication[]
  donations    CrewDonation[]
}

// A player's application to join a crew, with their answers. Deleted once the leader decides.
model CrewApplication {
  id        String   @id @default(cuid())
  crewId    String
  playerId  String
  answers   Json?
  createdAt DateTime @default(now())

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([crewId, playerId])
}

// Money a member put into the crew bank.
model CrewDonation {
  id        String   @id @default(cuid())
  crewId    String
  playerId  String
  amount    Int
  createdAt DateTime @default(now())

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([crewId])
}

// A car in a player's garage. The model key points into src/lib/era.ts.
model Car {
  id        String   @id @default(cuid())
  ownerId   String
  model     String
  originCity String  @default("London") // where it was stolen
  city       String  @default("London") // where it is now
  heat       Int     @default(0)
  plate      String  @default("")
  damage     Int     @default(0) // 0 = perfect, 50 = badly knocked about
  heatAt     DateTime @default(now())
  // Crates of booze in the boot, keyed by booze key.
  cargo      Json?
  // Set while the car is held by the Escrow agent; it can't be used or sold until the trade ends.
  escrowId   String?
  createdAt DateTime @default(now())

  owner Player @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// One casino per game per city. ownerId = null means the house runs it.
model Casino {
  id         String    @id @default(cuid())
  city       String
  game       String
  ownerId    String?
  maxBet     Int       @default(5000)
  profit     Int       @default(0)
  plays      Int       @default(0)
  wagered    Int       @default(0)
  ownedSince DateTime?
  // Set while the casino is held by the Escrow agent: nobody can gamble at it or change it.
  escrowId   String?

  owner Player? @relation("CasinoOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([city, game])
  @@index([ownerId])
}

// One bullet factory per city. Produces a batch on a timer while the owner
// can pay for the steel.
model BulletFactory {
  id             String   @id @default(cuid())
  city           String   @unique
  ownerId        String?
  stock          Int      @default(0)
  pricePerBullet Int      @default(3)
  lastProducedAt DateTime @default(now())
  totalProduced  Int      @default(0)
  revenue        Int      @default(0)

  owner Player? @relation("BulletFactoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model InventoryItem {
  id       String @id @default(cuid())
  playerId String
  itemType String
  quantity Int    @default(1)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemType])
}

model CrimeLog {
  id         String   @id @default(cuid())
  playerId   String
  crimeType  String
  success    Boolean
  cashChange Int
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CasinoLog {
  id        String   @id @default(cuid())
  playerId  String
  game      String
  bet       Int
  payout    Int
  outcome   Json
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}
