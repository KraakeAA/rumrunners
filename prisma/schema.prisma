generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  isAdmin      Boolean  @default(false)

  player Player?
}

model Player {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  rank         String   @default("Scum")
  rankLevel    Int      @default(1)
  money        Int      @default(500)
  bank         Int      @default(0)
  gold         Int      @default(0)
  bullets      Int      @default(0)
  health       Int      @default(100)
  protection   Int      @default(0)
  energy       Int      @default(10)
  maxEnergy    Int      @default(10)
  experience   Int      @default(0)
  lastEnergyAt DateTime @default(now())
  lastCrimeAt  DateTime?
  lastTheftAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Location and railway travel
  currentCity      String    @default("London")
  travelDestination String?
  travelStartedAt   DateTime?
  travelArrivesAt   DateTime?

  // Profile information
  profilePictureUrl String? @db.Text
  profileQuote      String? @db.Text
  profileStatus     String? @db.Text
  statusExpiresAt   DateTime?
  profileViews      Int     @default(0)

  // Profile privacy and display preferences
  profileVisible     Boolean @default(true)
  showProfileViews   Boolean @default(true)
  showHistory        Boolean @default(false)
  showBirthday       Boolean @default(false)
  showCountry        Boolean @default(false)
  showOrganization   Boolean @default(true)
  showOcStatus       Boolean @default(true)
  allowProfileImages Boolean @default(true)
  friendsOnlyImages  Boolean @default(false)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]
  crimeLogs  CrimeLog[]
  casinoLogs CasinoLog[]

  forumTopics ForumTopic[] @relation("ForumTopicAuthor")
  forumPosts  ForumPost[]  @relation("ForumPostAuthor")

  ownedCasinos         Casino[]        @relation("CasinoOwner")
  ownedBulletFactories BulletFactory[] @relation("BulletFactoryOwner")
  cars                 Car[]
}

// A car in a player's garage. The model key points into src/lib/era.ts.
model Car {
  id        String   @id @default(cuid())
  ownerId   String
  model     String
  originCity String  @default("London") // where it was stolen
  city       String  @default("London") // where it is now
  heat       Int     @default(0)
  plate      String  @default("")
  damage     Int     @default(0) // 0 = perfect, 50 = badly knocked about
  heatAt     DateTime @default(now())
  createdAt DateTime @default(now())

  owner Player @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// One casino per game per city. ownerId = null means the house runs it.
model Casino {
  id         String    @id @default(cuid())
  city       String
  game       String
  ownerId    String?
  maxBet     Int       @default(5000)
  profit     Int       @default(0)
  plays      Int       @default(0)
  wagered    Int       @default(0)
  ownedSince DateTime?

  owner Player? @relation("CasinoOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([city, game])
  @@index([ownerId])
}

// One bullet factory per city. Produces a batch on a timer while the owner
// can pay for the steel.
model BulletFactory {
  id             String   @id @default(cuid())
  city           String   @unique
  ownerId        String?
  stock          Int      @default(0)
  pricePerBullet Int      @default(25)
  lastProducedAt DateTime @default(now())
  totalProduced  Int      @default(0)
  revenue        Int      @default(0)

  owner Player? @relation("BulletFactoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model InventoryItem {
  id       String @id @default(cuid())
  playerId String
  itemType String
  quantity Int    @default(1)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemType])
}

model CrimeLog {
  id         String   @id @default(cuid())
  playerId   String
  crimeType  String
  success    Boolean
  cashChange Int
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CasinoLog {
  id        String   @id @default(cuid())
  playerId  String
  game      String
  bet       Int
  payout    Int
  outcome   Json
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model ForumTopic {
  id        String   @id @default(cuid())
  category  String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String

  author Player       @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  posts  ForumPost[]

  @@index([category, pinned, createdAt])
}

model ForumPost {
  id        String   @id @default(cuid())
  body      String   @db.Text
  createdAt DateTime @default(now())
  authorId  String
  topicId   String

  author Player     @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
}
